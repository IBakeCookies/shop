{
    "name": "shop",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier .",
        "format:fix": "prettier --write .",
        "eslint": "eslint .",
        "eslint:fix": "eslint . --fix",
        "lint": "npm run format:fix && npm run eslint:fix",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "npx playwright test --ui",
        "test": "npm run test:unit -- --run && npm run test:e2e",
        "check:deps-minor": "npx taze",
        "check:deps-major": "npx taze major",
        "storybook": "storybook dev -p 6006 --no-open",
        "build:storybook": "storybook build"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^3.2.5",
        "@eslint/compat": "^1.2.7",
        "@eslint/js": "^9.21.0",
        "@iconify/svelte": "^4.2.0",
        "@playwright/test": "^1.51.0",
        "@storybook/addon-essentials": "^8.6.4",
        "@storybook/addon-interactions": "^8.6.4",
        "@storybook/addon-svelte-csf": "^5.0.0-next.27",
        "@storybook/blocks": "^8.6.4",
        "@storybook/svelte": "^8.6.4",
        "@storybook/sveltekit": "^8.6.4",
        "@storybook/test": "^8.6.4",
        "@sveltejs/adapter-vercel": "^5.6.3",
        "@sveltejs/kit": "^2.18.0",
        "@sveltejs/vite-plugin-svelte": "^5.0.3",
        "@tailwindcss/vite": "^4.0.12",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/svelte": "^5.2.7",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-svelte": "^3.0.3",
        "globals": "^16.0.0",
        "jsdom": "^26.0.0",
        "mdsvex": "^0.12.3",
        "prettier": "^3.5.3",
        "prettier-plugin-svelte": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "storybook": "^8.6.4",
        "svelte": "^5.22.6",
        "svelte-check": "^4.1.5",
        "tailwindcss": "^4.0.12",
        "taze": "^18.7.1",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.0",
        "vite": "^6.2.1",
        "vitest": "^3.0.8"
    },
    "dependencies": {
        "@inlang/paraglide-sveltekit": "^0.16.0",
        "@supabase/supabase-js": "^2.49.1",
        "@total-typescript/ts-reset": "^0.6.1",
        "clsx": "^2.1.1",
        "ramda": "^0.30.1",
        "tailwind-merge": "^3.0.2",
        "type-fest": "^4.37.0"
    }
}
