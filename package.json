{
    "name": "shop",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier .",
        "format:fix": "prettier --write .",
        "eslint": "eslint .",
        "eslint:fix": "eslint . --fix",
        "lint": "npm run format:fix && npm run eslint:fix",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "npx playwright test --ui",
        "test:storybook": "test-storybook",
        "test": "npm run test:unit -- --run && npm run test:e2e",
        "check:deps-minor": "npx taze",
        "check:deps-major": "npx taze major",
        "storybook": "storybook dev -p 6006 --no-open",
        "storybook:build": "storybook build",
        "machine-translate": "inlang machine translate --project project.inlang"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^4.0.1",
        "@eslint/compat": "^1.3.1",
        "@eslint/js": "^9.30.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.4.2",
        "@iconify/svelte": "^5.0.0",
        "@inlang/cli": "^3.0.12",
        "@inlang/paraglide-js": "2.0.7",
        "@lucide/svelte": "^0.525.0",
        "@playwright/test": "^1.53.2",
        "@storybook/addon-docs": "^9.0.15",
        "@storybook/addon-svelte-csf": "^5.0.4",
        "@storybook/sveltekit": "^9.0.15",
        "@storybook/test-runner": "^0.23.0",
        "@sveltejs/adapter-node": "^5.2.12",
        "@sveltejs/adapter-vercel": "^5.7.2",
        "@sveltejs/kit": "^2.22.2",
        "@sveltejs/vite-plugin-svelte": "^5.1.0",
        "@tailwindcss/vite": "^4.1.11",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/svelte": "^5.2.8",
        "effect": "^3.16.10",
        "eslint": "^9.30.1",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-storybook": "9.0.13",
        "eslint-plugin-svelte": "^3.10.1",
        "globals": "^16.3.0",
        "jsdom": "^26.1.0",
        "mdsvex": "^0.12.6",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.6.13",
        "storybook": "^9.0.15",
        "svelte": "^5.34.9",
        "svelte-check": "^4.2.2",
        "sveltekit-superforms": "^2.27.1",
        "tailwind-variants": "^1.0.0",
        "tailwindcss": "^4.1.11",
        "taze": "^19.1.0",
        "tw-animate-css": "^1.3.5",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.35.1",
        "vite": "^6.3.5",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@stripe/stripe-js": "^7.4.0",
        "@supabase/supabase-js": "^2.50.2",
        "@total-typescript/ts-reset": "^0.6.1",
        "clsx": "^2.1.1",
        "ramda": "^0.31.3",
        "stripe": "^18.3.0",
        "swiper": "^11.2.10",
        "tailwind-merge": "^3.3.1",
        "type-fest": "^4.41.0"
    }
}
