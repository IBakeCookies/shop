{
    "name": "shop",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier .",
        "format:fix": "prettier --write .",
        "eslint": "eslint .",
        "eslint:fix": "eslint . --fix",
        "lint": "npm run format:fix && npm run eslint:fix",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "npx playwright test --ui",
        "test:storybook": "test-storybook",
        "test": "npm run test:unit -- --run && npm run test:e2e",
        "check:deps-minor": "npx taze",
        "check:deps-major": "npx taze major",
        "storybook": "storybook dev -p 6006 --no-open",
        "build:storybook": "storybook build",
        "machine-translate": "inlang machine translate --project project.inlang"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^3.2.6",
        "@eslint/compat": "^1.2.9",
        "@eslint/js": "^9.27.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
        "@iconify/svelte": "^4.2.0",
        "@inlang/cli": "^3.0.11",
        "@inlang/paraglide-js": "2.0.7",
        "@playwright/test": "^1.52.0",
        "@storybook/addon-essentials": "^8.6.14",
        "@storybook/addon-interactions": "^8.6.14",
        "@storybook/addon-svelte-csf": "^5.0.1",
        "@storybook/blocks": "^8.6.14",
        "@storybook/svelte": "^8.6.14",
        "@storybook/sveltekit": "^8.6.14",
        "@storybook/test": "^8.6.14",
        "@storybook/test-runner": "^0.22.0",
        "@sveltejs/adapter-node": "^5.2.12",
        "@sveltejs/adapter-vercel": "^5.7.2",
        "@sveltejs/kit": "^2.21.1",
        "@sveltejs/vite-plugin-svelte": "^5.0.3",
        "@tailwindcss/vite": "^4.1.7",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/svelte": "^5.2.8",
        "effect": "^3.15.4",
        "eslint": "^9.27.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-svelte": "^2.46.1",
        "globals": "^16.2.0",
        "jsdom": "^26.1.0",
        "mdsvex": "^0.12.6",
        "prettier": "^3.5.3",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "storybook": "^8.6.14",
        "svelte": "^5.33.3",
        "svelte-check": "^4.2.1",
        "sveltekit-superforms": "^2.25.0",
        "tailwindcss": "^4.1.7",
        "taze": "^18.7.1",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.1",
        "vite": "^6.3.5",
        "vitest": "^3.1.4"
    },
    "dependencies": {
        "@stripe/stripe-js": "^6.1.0",
        "@supabase/supabase-js": "^2.49.8",
        "@total-typescript/ts-reset": "^0.6.1",
        "clsx": "^2.1.1",
        "ramda": "^0.30.1",
        "stripe": "^17.7.0",
        "swiper": "^11.2.8",
        "tailwind-merge": "^3.3.0",
        "type-fest": "^4.41.0"
    }
}
