{
    "name": "shop",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier . --check",
        "format:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint-format": "npm run format:fix && npm run lint:fix",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:storybook": "test-storybook",
        "test": "npm run test:unit -- --run && npm run test:e2e",
        "check:deps-minor": "npx taze",
        "check:deps-major": "npx taze major",
        "storybook": "storybook dev -p 6006 --no-open",
        "storybook:build": "storybook build",
        "machine-translate": "inlang machine translate --project project.inlang"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^4.1.3",
        "@eslint/compat": "^1.4.1",
        "@eslint/js": "^9.39.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "@iconify/svelte": "^5.1.0",
        "@inlang/cli": "^3.0.12",
        "@inlang/paraglide-js": "2.0.7",
        "@lucide/svelte": "^0.525.0",
        "@playwright/test": "^1.56.1",
        "@storybook/addon-docs": "^9.1.16",
        "@storybook/addon-svelte-csf": "^5.0.10",
        "@storybook/sveltekit": "^9.1.16",
        "@storybook/test-runner": "^0.23.0",
        "@sveltejs/adapter-node": "^5.4.0",
        "@sveltejs/adapter-vercel": "^5.10.3",
        "@sveltejs/kit": "^2.49.0",
        "@sveltejs/vite-plugin-svelte": "^5.1.1",
        "@tailwindcss/vite": "^4.1.17",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.2.9",
        "dependency-cruiser": "^17.3.8",
        "effect": "^3.19.6",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-storybook": "9.0.13",
        "eslint-plugin-svelte": "^3.13.0",
        "globals": "^16.5.0",
        "jsdom": "^26.1.0",
        "mdsvex": "^0.12.6",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "storybook": "^9.1.16",
        "svelte": "^5.43.14",
        "svelte-check": "^4.3.4",
        "sveltekit-superforms": "^2.28.1",
        "tailwind-variants": "^1.0.0",
        "tailwindcss": "^4.1.17",
        "taze": "^19.9.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.47.0",
        "vite": "^6.4.1",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@stripe/stripe-js": "^7.9.0",
        "@supabase/supabase-js": "^2.84.0",
        "@total-typescript/ts-reset": "^0.6.1",
        "clsx": "^2.1.1",
        "ramda": "^0.31.3",
        "stripe": "^18.5.0",
        "swiper": "^11.2.10",
        "tailwind-merge": "^3.4.0",
        "type-fest": "^4.41.0"
    }
}
