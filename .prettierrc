{
    "useTabs": false,
    "tabWidth": 4,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 80,
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "tailwindAttributes": ["modifier"],
    "tailwindFunctions": ["cn"],
    "plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": "*.svelte",
            "options": {
                "parser": "svelte"
            }
        }
    ]
}
