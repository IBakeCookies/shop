{
    "useTabs": false,
    "tabWidth": 4,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "tailwindAttributes": ["modifier"],
    "tailwindFunctions": ["cn"],
    "plugins": [
        "prettier-plugin-svelte",
        "prettier-plugin-tailwindcss",
        "@ianvs/prettier-plugin-sort-imports"
    ],
    "importOrder": [
        "<TYPES>",
        "<BUILT_IN_MODULES>",
        "<BUILTIN_MODULES>",
        "<THIRD_PARTY_MODULES>",
        "$lib/(.*)$",
        "^@src/(.*)$",
        "^@application/(.*)$",
        "^@data/(.*)$",
        "^@business/(.*)$",
        "^@store/(.*)$",
        "^@storage/(.*)$",
        "^@presentation/(.*)$",
        "^@style/(.*)$",
        "^@page/(.*)$",
        "^@layout/(.*)$",
        "^@template/(.*)$",
        "^@container/(.*)$",
        "^@organism/(.*)$",
        "^@molecule/(.*)$",
        "^@atom/(.*)$"
    ],
    "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
    "importOrderTypeScriptVersion": "5.0.0",
    "importOrderCaseSensitive": false,
    "overrides": [
        {
            "files": "*.svelte",
            "options": {
                "parser": "svelte"
            }
        }
    ]
}
